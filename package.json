{
  "name": "book-shop",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n server,client -c yellow,cyan \"pnpm --filter server dev\" \"wait-on tcp:6431 && pnpm --filter client dev\"",
    "dev:server": "pnpm --filter server dev",
    "dev:client": "pnpm --filter client dev",
    "lint:server": "pnpm --filter server lint",
    "lint:client": "pnpm --filter client lint"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "wait-on": "^8.0.0"
  }
}
