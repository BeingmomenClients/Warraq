# ---------------------------------------------------------------
# انسخ هذا الملف باسم  config.env  في نفس المجلد ثم املأ القيم.
#   cp config.env.example config.env
#
# الاسم مهم: الخادم يقرأ ./config.env تحديداً (server.js) وليس .env
# ---------------------------------------------------------------

# البيئة — لا تتركها فارغة في الإنتاج.
# القيمة production تفعّل الكوكيز الآمنة (Secure) عبر HTTPS.
NODE_ENV=production

# المنفذ الذي يستمع عليه الخادم داخل الحاوية
PORT=6431

# رابط اتصال MongoDB (Atlas أو أي MongoDB آخر)
DATABASE_ATLAS=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/DB_NAME

# ---------------------------------------------------------------
# المصادقة (JWT)
# ---------------------------------------------------------------

# سر توقيع التوكن — يجب أن يكون عشوائياً وطويلاً (32 حرفاً فأكثر).
# ولّده بأمر:  openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# مدة صلاحية التوكن
JWT_EXPIRES_IN=5h

# مدة بقاء الكوكي بالأيام (رقم فقط)
JWT_COOKIE_EXPIRES_IN=5

# ---------------------------------------------------------------
# البريد الإلكتروني — يُستخدم لرسالة الترحيب واستعادة كلمة المرور.
# الإرسال يتم عبر Gmail SMTP (smtp.gmail.com:587) من utils/sendMail.js
# ---------------------------------------------------------------

# حساب Gmail المُرسِل
STAMP_MAIL=no-reply@example.com

# ⚠️ ليست كلمة مرور الحساب — بل "App Password" من إعدادات Google
# https://myaccount.google.com/apppasswords  (يتطلب تفعيل 2FA)
STAMP_PASSWORD=xxxx xxxx xxxx xxxx

# العنوان الظاهر للمستلم في خانة "من"
EMAIL_FROM=no-reply@example.com

# ---------------------------------------------------------------
# هوية الرسائل
# ---------------------------------------------------------------

# اسم الموقع — يظهر في عنوان الرسالة ونصها
SITE_NAME=Book_Shop

# توقيع المدير أسفل الرسالة
MANAGER=- Book_Shop Org.
